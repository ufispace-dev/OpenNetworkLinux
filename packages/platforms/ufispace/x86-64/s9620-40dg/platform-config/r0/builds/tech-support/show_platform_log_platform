#### platform specific
function _plat_ts_version {
    echo "1.0.0"
}

function _set_plat_vars {
    PLAT="S9620-40DG"

    _set_board_info

    # 2. Dynamic topological routing based on the detected HW_REV_ID
    if [ "${HW_REV_ID}" -le 1 ]; then
        # ===============================================================
        # Alpha / Proto Hardware Configuration (HW_REV_ID <= 1)
        # ===============================================================
        # --- BIOS/BOOT Settings ---
        # EC BIOS BOOT SEL is at LPC offset 0xE30C, bit 6 (D[6])
        # Format: "LPC/I2C Address,Bit Position"
        BIOS_BOOT_SEL_REG="0xE30C,6"
        BIOS_BOOT_SEL_REG_MASK=""

        IOPORT_ADDRESS=(
            "0xE00-0xEFF"   # Main Board CPLD & Registers
            "0x2300-0x23FF" # CPU EC & Other Registers
        )

        CPLD_I2C_POSITION=(
            "${I801_BUS},,,0x76,0,cpld1,2,0x26"
            "${I801_BUS},,,0x76,0,cpld2,2,0x27"
            "${I801_BUS},0x76,3,0x75,0,cpld3,6,0x25"
            "${I801_BUS},0x76,3,0x75,0,cpld4,6,0x24"
        )

        I2C_DEV_INFO=(
            "${I801_BUS},0x76" # PCA9546 Root Mux on I801
            "${ISMT_BUS},0x75" # PCA9546 Root Mux on ISMT
            "2,0x26"           # CPLD1 on Bus 2
            "2,0x27"           # CPLD2 on Bus 2
            "5,0x75"           # Legacy PCA9548 MB Mux on Bus 5
            "6,0x25"           # CPLD3 on Bus 6
            "6,0x24"           # CPLD4 on Bus 6
        )

        I2C_TREE=(
            "${I801_BUS},,,,,9546_ROOT_I801,4,0x76"
            "${ISMT_BUS},,,,,9546_ROOT_ISMT,4,0x75"
            "${I801_BUS},,,0x76,3,9548_MB_MUX,8,0x75"
        )

        SYS_EEPROM="${ISMT_BUS},,,,,0x57"
        BMC_SUPPORT=1

    else
        # ===============================================================
        # Beta Hardware Configuration (HW_REV_ID > 1)
        # ===============================================================
        # --- BIOS/BOOT Settings ---
        # EC BIOS BOOT SEL is at LPC offset 0xE30C, bit 6 (D[6])
        # Format: "LPC/I2C Address,Bit Position"
        BIOS_BOOT_SEL_REG="0xE30C,6"
        BIOS_BOOT_SEL_REG_MASK=""

        # --- LPC I/O Port Scan Range ---
        # Define the LPC address ranges to be dumped via dd command
        IOPORT_ADDRESS=(
            "0xE00-0xEFF"   # Main Board CPLD & Registers
            "0x2300-0x23FF" # CPU EC & Other Registers
        )

        # --- I2C Topology & Device Definition (Beta: CPLD Mux Design) ---
        # Define the CPLD positions within the I2C tree for direct i2cget commands.
        # Format: root_bus, grandparent_addr, grandparent_channel, parent_addr, parent_channel, device_name, target_bus, target_addr
        CPLD_I2C_POSITION=(
            "${I801_BUS},,,0x76,0,cpld1,2,0x26"
            "${I801_BUS},,,0x76,0,cpld2,2,0x27"
            "${I801_BUS},,,0x76,3,cpld3,5,0x25"
            "${I801_BUS},,,0x76,3,cpld4,5,0x24"
        )

        # Define simple I2C devices to be polled/dumped directly
        # Format: "bus,address"
        I2C_DEV_INFO=(
            "${I801_BUS},0x76" # PCA9546 Root Mux on I801
            "${ISMT_BUS},0x75" # PCA9546 Root Mux on ISMT
            "2,0x26"           # CPLD1 on Bus 2
            "2,0x27"           # CPLD2 on Bus 2
            "5,0x25"           # CPLD3 on Bus 5
            "5,0x24"           # CPLD4 on Bus 5
        )

        # Define the full I2C Tree topology for MUX traversal
        # Format: bus, grandparent_addr, grandparent_channel, parent_addr, parent_channel, name, channel_num, addr
        I2C_TREE=(
            "${I801_BUS},,,,,9546_ROOT_I801,4,0x76"
            "${ISMT_BUS},,,,,9546_ROOT_ISMT,4,0x75"
            "${ISMT_BUS},,,0x75,1,9546_MB_MUX,4,0x76"
        )

        # Define System EEPROM path
        SYS_EEPROM="${ISMT_BUS},,,,,0x57"

        # --- Feature Support Flags ---
        # 1: Supported, 0: Not Supported
        BMC_SUPPORT=1
    fi
}

function _show_extra_info {
    :
}

function _set_board_info {
    # Default arrays mapping the hardware ID to actual model strings
    local model_id_array=($((2#11101110)) $((2#11101111)))
    local model_name_array=("Q3A S9620-40DG ALPHA" "Q3A S9620-40DG BETA")
    local ret=""
    local found="0"
    local i=0

    # Read SKU ID from CPLD1 0xE00 Register via LPC
    local model_id=$(_dd_read_byte 0xE00)
    ret=$?

    if [ $ret -eq 0 ]; then
        # Ensure proper extraction and cast to integer
        model_id=$((model_id))
        MODEL_ID=$(((model_id & 2#11111111) >> 0))

        for (( i=0; i<${#model_id_array[@]}; i++ ))
        do
            if (( MODEL_ID == model_id_array[i] )); then
                MODEL_NAME="${model_name_array[$i]}"
                found="1"
                break
            fi
        done

        if [ "$found" = "0" ]; then
            MODEL_NAME="S9620-40DG UNKNOWN"
        fi
    fi

    # Read CPLD1 0x01 HW & Build Revision Register via LPC
    local board_rev_id=$(_dd_read_byte 0xE01)
    ret=$?

    if [ $ret -eq 0 ]; then
        board_rev_id=$((board_rev_id))

        # Design Phase: DEPH D[2]
        DEPH_ID=$(((board_rev_id & 2#00000100) >> 2))

        # Hardware Revision: HW Rev D[0:1]
        HW_REV_ID=$(((board_rev_id & 2#00000011) >> 0))

        # Build Revision: Build Rev D[3:5]
        BUILD_REV_ID=$(((board_rev_id & 2#00111000) >> 3))
    fi
}

